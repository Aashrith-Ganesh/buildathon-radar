# ==============================================================================
# Buildathon Radar - Environment Configuration (Student Edition)
# ==============================================================================

# Core Application Settings (No Paid APIs Required!)
# The application uses transparent, local rule-based filtering tailored for
# Class 11/12 high-school students in Bengaluru by default.

# Tracker Base URL for Track/Applied/Dashboard links (Defaults to local host)
TRACKER_BASE_URL=http://127.0.0.1:8015

# Secret used to sign Track/Applied action links in digests
# Auto-generated securely if omitted, or set with: python3 -c "import secrets; print(secrets.token_hex(32))"
TRACKER_SECRET=

# ------------------------------------------------------------------------------
# Optional Email Notifications (Digest is archived locally in archive/ by default)
# ------------------------------------------------------------------------------
# Flip to true only if you want weekly digests emailed via Gmail SMTP
ENABLE_EMAIL=false
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
RECIPIENT_EMAIL=your_email@gmail.com

# ------------------------------------------------------------------------------
# Optional AI Overrides (NOT REQUIRED)
# ------------------------------------------------------------------------------
# Set to true only if you want Claude to override the rule-based filter
USE_CLAUDE=false
ANTHROPIC_API_KEY=

# Optional TypeSafe Jev triage pre-filter (Off by default)
ENABLE_JEV_TRIAGE=false
TYPESAFE_API_KEY=
